# Frontend env — docs 06 §2
# Production: URL of the .NET API (behind Cloudflare) used for every call.
VITE_API_URL=http://localhost:5131/api/v1

# Supabase client keys (public) — used for Auth OTP + Storage RLS.
# NEVER set VITE_ prefix on the service-role key (server-only, docs 06 §2).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
