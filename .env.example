# BadmintonBooking — example environment variables.
#
# Copy to `.env` (not committed) and fill in real values, OR set these in
# your CI / host environment. ASP.NET Core reads these directly from the
# process environment; a `__` separates config section levels.
#
#   export $(grep -v '^#' .env | xargs)     # quick load on Linux/mac
#
# ---------------------------------------------------------------- JWT
# Symmetric signing key. MUST be a strong, random, >= 32-char secret in
# production (enforced by Program.cs fail-fast). Never commit a real one.
JwtSettings__Key=change-me-strong-random-secret-32+chars

# ---------------------------------------------------------------- Payments
# "mock" (default) → signature-free mock gateways for dev/test.
# "real" → real MoMo/VnPay/Zalopay adapters; each is inert until its own
# credentials are provisioned (fail closed — requests return an error, not
# a crash, when a real gateway has no secrets).
Payment__Provider=mock

# MoMo (P0-1)
Payment__Momo__AppId=
Payment__Momo__SecretKey=
Payment__Momo__Endpoint=https://app.tapmomo.vn
Payment__Momo__IpayUrl=https://your-api.example.com/api/v1/payments/webhook/momo

# VnPay (9.5+)
Payment__Vnpay__MerchantCode=
Payment__Vnpay__SecretKey=
Payment__Vnpay__Endpoint=https://sandbox.vnpay.io
Payment__Vnpay__CallbackUrl=https://your-api.example.com/api/v1/payments/webhook/vnpay

# Zalopay (9.5+)
Payment__Zalopay__AppId=
Payment__Zalopay__ApiKey=
Payment__Zalopay__ApiSecret=
Payment__Zalopay__Endpoint=https://external.zalopay.net
Payment__Zalopay__CallbackUrl=https://your-api.example.com/api/v1/payments/webhook/zalopay

# ---------------------------------------------------------------- Notify (FEAT 1)
# Comma list of active channels: log,email,sms,zalo (default log = no external calls).
Notify__Channels=log
# email = generic HTTP mail relay (Send-Email API)
Notify__Email__Endpoint=
Notify__Email__Key=
Notify__FromAddress=badminton@example.com
# sms = provider-agnostic HTTP SMS API
Notify__Sms__Endpoint=
Notify__Sms__Key=
# zalo = Zalo OA webhook
Notify__Zalo__Endpoint=
Notify__Zalo__Token=

# ---------------------------------------------------------------- Membership V2 (FEAT 4)
# Points multiplier per tier + membership duration (days).
Membership__MultiplierSilver=1.5
Membership__MultiplierGold=2.0
Membership__SilverDays=30
Membership__GoldDays=90

# ---------------------------------------------------------------- Seed guard (9.5+)
# Set to true ONLY in isolated CI sandboxes that need the 500-user demo
# data. In a real production deploy this MUST be false (or unset).
Seed__AllowInProduction=false

# ---------------------------------------------------------------- Logging (9.5+)
# Directory for the structured JSON log files. Leave blank to use ./logs/.
Logging__FileDirectory=

# ---------------------------------------------------------------- DB
# Override the connection string shipped in appsettings.json. Production
# should point at a real SQL Server, not (localdb)\\MSSQLLocalDB.
ConnectionStrings__BadmintonBooking=Server=(localdb)\\MSSQLLocalDB;Database=BadmintonBooking;Trusted_Connection=True;TrustServerCertificate=True;

# ---------------------------------------------------------------- Runtime
# ASPNETCORE_ENVIRONMENT=Development
# Prometheus metrics endpoint is at /metrics — no env keys needed.
