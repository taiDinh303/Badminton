# BadmintonBooking — example environment variables.
#
# Copy to `.env` (not committed) and fill in real values, OR set these in
# your CI / host environment. ASP.NET Core reads these directly from the
# process environment; a `__` separates config section levels.
#
#   export $(grep -v '^#' .env | xargs)     # quick load on Linux/mac
#
# ---------------------------------------------------------------- JWT
# Symmetric signing key. MUST be a strong, random, >= 32-char secret in
# production (enforced by Program.cs fail-fast). Never commit a real one.
JwtSettings__Key=change-me-strong-random-secret-32+chars

# ---------------------------------------------------------------- DB
# Override the connection string shipped in appsettings.json. Production
# should point at a real SQL Server, not (localdb)\\MSSQLLocalDB.
ConnectionStrings__BadmintonBooking=Server=(localdb)\\MSSQLLocalDB;Database=BadmintonBooking;Trusted_Connection=True;TrustServerCertificate=True;

# ---------------------------------------------------------------- Runtime
# ASPNETCORE_ENVIRONMENT=Development
