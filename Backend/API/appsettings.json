{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BadmintonBooking": "Server=(localdb)\\MSSQLLocalDB;Database=BadmintonBooking;Trusted_Connection=True;TrustServerCertificate=True;Max Pool Size=1000;Min Pool Size=50;Connection Timeout=5;"
  },
  "JwtSettings": {
    "Issuer": "BadmintonBooking",
    "Audience": "BadmintonBookingClient",
    "ExpireMinutes": 60
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "DatabaseInitialization": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Payment": {
    "Provider": "mock"
  },
  "Notify": {
    "Channels": "log"
  },
  "Swagger": {
    "Enabled": false
  }
}
